{
  "defaultModel": "openrouter/deepseek/deepseek-v4-pro",
  "enableSkillCommands": true,
  "enabledModels": [
    "openrouter/deepseek/deepseek-v4-pro",
    "openrouter/deepseek/deepseek-v4-flash"
  ],
  "sessionDir": ".pi/sessions",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "terminal": {
    "showImages": true,
    "imageWidthCells": 50
  },
  "images": {
    "autoResize": true
  }
}
